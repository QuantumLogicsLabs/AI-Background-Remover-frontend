# ============================================================
# Frontend — Environment Variables
# Copy this file to frontend/.env and fill in your values.
# Owned by: Web Team (UI)
# ============================================================

# ----- API Base URL -------------------------------------------
# DEVELOPMENT:
#   Leave this commented out. Vite's dev proxy (vite.config.ts) already
#   forwards all /api requests to http://127.0.0.1:8000, so no value is
#   needed during local development.
#
# PRODUCTION (Vercel / Netlify / any static host):
#   Uncomment and set this to your deployed backend URL.
#   The frontend's apiClient.ts reads this value at build time.
#   Example: https://api.yourdomain.com
#
# VITE_API_BASE_URL=https://api.yourdomain.com

# ----- Feature Flags ------------------------------------------
# Uncomment and set to "true" to enable features still in development.
# VITE_ENABLE_BATCH_UPLOAD=false
# VITE_ENABLE_AUTH=true

# ----- App Meta (optional) ------------------------------------
# Override the default app name shown in the browser tab and PWA manifest.
# VITE_APP_NAME=AI Background Remover
